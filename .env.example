# Veritas Blue Web Environment Configuration Example
# Make a copy of this file as .env and fill in your own values

# ─────────────────────────────────────────────────────────────────────────────
# AI MODEL CONFIGURATION
#
# All text-generating AI on this site runs on OpenAI gpt-5.6-luna at "high"
# reasoning effort. The single source of truth is apps/api/config/aiModel.js;
# these two vars override it globally. Leave them unset to use the defaults.
#
# gpt-5.6-luna: 1.05M context, 128K max output, text+image in / text out,
# $1 per 1M input / $6 per 1M output. No audio modality.
# ─────────────────────────────────────────────────────────────────────────────
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=high

# Floor on max_output_tokens. Reasoning models burn output tokens on hidden
# reasoning BEFORE emitting visible text; if the cap is too low the API returns
# status 'incomplete' with no visible output and you are billed anyway.
# OpenAI recommends reserving >=25000 tokens for reasoning + output.
# This is a CEILING, not a spend — you pay for tokens generated, not the cap.
AI_MIN_OUTPUT_TOKENS=25000

# ── Per-feature reasoning effort ─────────────────────────────────────────────
# Valid values: minimal | low | medium | high  (Luna does not support xhigh/max)
#
# The AI Coach is an interactive chat surface and deliberately runs BELOW the
# site-wide 'high': OpenAI names 'low' as the right tier for chat-assistant
# workloads and 'high' for agentic/long-horizon work. Batch jobs such as exam
# quality control keep 'high'.
COACH_PRIMARY_REASONING_EFFORT=low
COACH_CLASSIFIER_REASONING_EFFORT=low
COACH_CHAT_REASONING_EFFORT=low
COACH_DEBRIEF_REASONING_EFFORT=medium
COACH_MICRO_LESSON_REASONING_EFFORT=medium
COACH_OBSERVE_REASONING_EFFORT=medium

# OpenAI API Configuration
# Frontend React env variables (must start with REACT_APP_)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here
REACT_APP_OPENAI_MODEL=gpt-5.6-luna

# Backend API env variables (for Express server)
OPENAI_API_KEY=your_openai_api_key_here
# Per-feature model overrides. All default to AI_MODEL (gpt-5.6-luna) when
# unset — only set these if a specific feature needs a different model.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
OPENAI_HELPER_MODEL=gpt-5.6-luna
OPENAI_QUESTION_GENERATION_MODEL=gpt-5.6-luna
OPENAI_QUESTION_REVIEW_MODEL=gpt-5.6-luna
OPENAI_QUESTION_GENERATION_MAX_COUNT=20
OPENAI_QUESTION_AUDIT_MAX_COUNT=50
OPENAI_QUESTION_GENERATION_MAX_OUTPUT_TOKENS=12000
OPENAI_QUESTION_REVIEW_MAX_OUTPUT_TOKENS=5000
# PDF ingestion (extract + validate stages)
OPENAI_INGEST_MODEL=gpt-5.6-luna
# Plotly graph generation (was Gemini, now OpenAI)
OPENAI_GRAPH_GENERATION_MODEL=gpt-5.6-luna
# Lesson block drafting script (was Gemini, now OpenAI)
OPENAI_LESSON_BLOCKS_MODEL=gpt-5.6-luna

# Exam quality control (server-only)
# gpt-5.6-luna accepts reasoning effort: minimal | low | medium | high.
# The sol-era values "max"/"xhigh" and the "pro" reasoning MODE are NOT valid
# for Luna — leave OPENAI_EXAM_QUALITY_REASONING_MODE empty.
OPENAI_EXAM_QUALITY_MODEL=gpt-5.6-luna
OPENAI_EXAM_QUALITY_REASONING_EFFORT=high
OPENAI_EXAM_QUALITY_REASONING_MODE=
OPENAI_EXAM_QUALITY_MAX_OUTPUT_TOKENS=24000
# Audits may run in parallel; repairs intentionally remain serial.
OPENAI_EXAM_QUALITY_AUDIT_CONCURRENCY=2

# Realtime voice companion — deliberately NOT gpt-5.6-luna.
# Luna has no audio modality, so voice stays on a realtime audio model.
REALTIME_MODEL=gpt-realtime-mini-2025-12-15
REALTIME_VOICE=cedar

# Firebase Admin SDK - use either service account file or environment variables
# For production (Render.com), use environment variables
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id",...}

# For development, a local service account file is used (see api/server.js)
# Make sure the file path in api/server.js points to your service account key

# Development Settings
REACT_APP_ENV=development

# Port Configuration
# React Dev Server uses PORT=3000
PORT=3000
# API Server uses port 3001 (configured in api/server.js)

# CORS Configuration
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# For production deployment on Render.com:
# NODE_ENV=production
# CLIENT_URL=https://your-app-domain.com

# Stripe Payment Configuration
# Get these from your Stripe Dashboard (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Graph Generation (Optional) — now powered by OpenAI, requires OPENAI_API_KEY
ENABLE_GRAPH_GENERATION=false

# GEMINI_API_KEY is no longer used for any text generation. It remains relevant
# ONLY for apps/web/src/scripts/generate_lecture_images.js (image generation),
# which cannot run on gpt-5.6-luna because Luna is text-output only.
GEMINI_API_KEY=your_gemini_api_key_here
